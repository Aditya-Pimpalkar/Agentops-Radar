# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://radar:radar@localhost:5433/agentops_radar

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9095

# ── Go ingestion service ──────────────────────────────────────────────────────
GRPC_PORT=9090
HTTP_PORT=8080
# API key validated by the ingestion service on every request
API_KEY=dev-api-key-change-in-production

# ── FastAPI ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-secret-key-in-production

# ── LLM judge (optional) ─────────────────────────────────────────────────────
# Set OPENAI_API_KEY to enable LLM-as-judge evaluation and run embeddings.
# Without it, rule-based evaluators still run; embed_consumer will skip.
OPENAI_API_KEY=
LLM_JUDGE_MODEL=gpt-4o-mini
LLM_JUDGE_ENABLED=false

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Kafka consumer group IDs (change per deployment to avoid offset conflicts)
KAFKA_GROUP_ID_STORE=radar-store
KAFKA_GROUP_ID_EVAL=radar-eval
KAFKA_GROUP_ID_EMBED=radar-embed
